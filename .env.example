# API
AUTH_REQUIRED=false
# Local-only stub (any non-empty Bearer). Never enable in production.
AUTH_DEV_STUB=false
OIDC_ISSUER=
OIDC_AUDIENCE=
# HS256 secret for tests / simple deploys (alternative to JWKS via OIDC_ISSUER)
OIDC_JWT_SECRET=
LLM_API_KEY=
USE_MEMORY_CHECKPOINTER=true
AGENTBRIDGE_FAKE_RUNTIME=0

# Postgres (business + checkpointer)
# Prefer a full DSN when set; otherwise host/port/database/user/password are joined.
PG_DSN=
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=agentbridge
PG_USER=postgres
PG_PASSWORD=change-me

# Run hooks: noop | logging
HOOKS_BACKEND=noop

# M4 single-node ops
RATE_LIMIT_PER_MINUTE=0
OTEL_ENABLED=false
ENABLE_DATA_SOURCE=false
# DATA_SOURCE_DSN=   # optional; falls back to PG_DSN / PG_*
# LLM_BACKEND=direct|gateway (default direct until golden switch)
LLM_BACKEND=direct
LOCK_BACKEND=memory
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
POLICY_BUNDLE_VERSION=role_policy/v1

# Knowledge backend (R-A)
# KNOWLEDGE_BACKEND=fake|langchain_pg|external|rag_agent_pg
KNOWLEDGE_BACKEND=fake
# RAG-Agent PostgreSQL is read-only and isolated to one explicit demo tenant.
# RAG_AGENT_PG_DSN=postgresql://readonly:change-me@127.0.0.1:5432/rag_agent
# RAG_AGENT_DEMO_TENANT=rag-agent-demo
# RAG_AGENT_EMBED_API_BASE=http://127.0.0.1:8080/v1
# RAG_AGENT_EMBED_API_KEY=EMPTY
# RAG_AGENT_EMBED_MODEL=BAAI/bge-m3
# RAG_AGENT_EMBED_DIMENSIONS=512
# KB_EXTERNAL_BASE_URL=http://127.0.0.1:9000   # required when external
# KB_EXTERNAL_API_KEY=
# KB_EXTERNAL_TIMEOUT_SECONDS=5
# KB_EXTERNAL_FAILURE_POLICY=empty_hits
# KB_DSN=                 # optional; falls back to PG_DSN
# EMBED_API_BASE=http://127.0.0.1:8080/v1
# EMBED_MODEL=your-tei-model
# EMBED_DIMENSIONS=1024   # must match apps/api/migrations/003_knowledge_pgvector.sql vector(N)
# EMBED_API_KEY=

# Authentik (docker compose --profile auth)
AUTHENTIK_SECRET_KEY=change-me-please-use-long-random
