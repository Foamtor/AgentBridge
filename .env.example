# API authentication: local is the default self-hosted console login.
# Container registry mirror used by the default Compose demo. Set
# IMAGE_REGISTRY=docker.io to use the official Docker Hub paths.
IMAGE_REGISTRY=docker.m.daocloud.io
# Optional Authentik image; override when using a private OIDC registry.
AUTHENTIK_IMAGE=docker.m.daocloud.io/ghcr.io/goauthentik/server:2024.8.3

AUTH_MODE=local
# AUTH_REQUIRED is retained for OIDC migration compatibility.
AUTH_REQUIRED=true
# Local-only stub (any non-empty Bearer). Never enable in production.
AUTH_DEV_STUB=false
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_SECONDS=43200
AUTH_SESSION_ABSOLUTE_SECONDS=86400
AUTH_PASSWORD_CHANGE_SECONDS=900
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=300
AUTH_INITIAL_PASSWORD_TTL_SECONDS=86400
OIDC_ISSUER=
OIDC_AUDIENCE=
# HS256 secret for tests / simple deploys (alternative to JWKS via OIDC_ISSUER)
OIDC_JWT_SECRET=
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
# fake keeps the bundled cases deterministic and offline.
# openai_compatible uses LLM_API_KEY, LLM_API_BASE and LLM_MODEL.
LLM_MODE=fake
# Compose and normal local verification use PostgreSQL, not in-memory state.
USE_MEMORY_CHECKPOINTER=false
OBSERVABILITY_STORE_BACKEND=postgres
AGENTBRIDGE_FAKE_RUNTIME=0

# Postgres (business + checkpointer)
# Prefer a full DSN when set; otherwise host/port/database/user/password are joined.
PG_DSN=
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=agentbridge
PG_USER=postgres
PG_PASSWORD=change-me

# Run hooks: noop | logging
HOOKS_BACKEND=noop

# M4 single-node ops
RATE_LIMIT_PER_MINUTE=0
OTEL_ENABLED=false
ENABLE_DATA_SOURCE=false
# DATA_SOURCE_DSN=   # optional; falls back to PG_DSN / PG_*
# LLM_BACKEND=direct|gateway (default direct until golden switch)
LLM_BACKEND=direct
LOCK_BACKEND=memory
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
POLICY_BUNDLE_VERSION=role_policy/v1

# Knowledge backend (R-A)
# KNOWLEDGE_BACKEND=fake|langchain_pg|external|rag_agent_pg
KNOWLEDGE_BACKEND=fake
# RAG-Agent PostgreSQL is read-only and isolated to one explicit demo tenant.
# RAG_AGENT_PG_DSN=postgresql://readonly:change-me@127.0.0.1:5432/rag_agent
# RAG_AGENT_DEMO_TENANT=rag-agent-demo
# RAG_AGENT_EMBED_API_BASE=http://127.0.0.1:8080/v1
# RAG_AGENT_EMBED_API_KEY=EMPTY
# RAG_AGENT_EMBED_MODEL=BAAI/bge-m3
# RAG_AGENT_EMBED_DIMENSIONS=512
# KB_EXTERNAL_BASE_URL=http://127.0.0.1:9000   # required when external
# KB_EXTERNAL_API_KEY=
# KB_EXTERNAL_TIMEOUT_SECONDS=5
# KB_EXTERNAL_FAILURE_POLICY=empty_hits
# KB_DSN=                 # optional; falls back to PG_DSN
# EMBED_API_BASE=http://127.0.0.1:8080/v1
# EMBED_MODEL=your-tei-model
# EMBED_DIMENSIONS=1024   # must match apps/api/migrations/003_knowledge_pgvector.sql vector(N)
# EMBED_API_KEY=

# Authentik (docker compose --profile auth)
AUTHENTIK_SECRET_KEY=change-me-please-use-long-random
